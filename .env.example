# ==============================================================================
# SPOTIFY DEVELOPER CONFIGURATION
# https://developer.spotify.com/dashboard
# ==============================================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_PLAYLIST_ID=your_target_playlist_id_here

# ==============================================================================
# TWITCH IRC CONFIGURATION
# Generate OAuth token: https://twitchapps.com/tmi/
# ==============================================================================
TWITCH_TOKEN=oauth:your_twitch_oauth_token_here
TWITCH_NICK=your_twitch_username_here
TWITCH_CHANNEL=your_channel_name_here

# ==============================================================================
# TIKTOK LIVE CONFIGURATION
# Your TikTok handle (without the @ symbol)
# ==============================================================================
TIKTOK_USERNAME=your_tiktok_handle_here

# ==============================================================================
# SONG REQUEST QUOTA CONFIGURATION
# ==============================================================================
# Maximum songs allowed per user (0 = unlimited)
MAX_SONGS_PER_USER=3

# Limit duration:
# 0 = Per-stream session (resets on bot restart or via !resetrequests in Twitch chat)
# >0 = Rolling sliding-window in minutes (e.g., 60 = max 3 songs every 60 mins)
USER_LIMIT_WINDOW_MINUTES=0

# Spotify Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_PLAYLIST_ID=your_spotify_playlist_id

# TikTok Credentials
TIKTOK_USERNAME=your_tiktok_username

# Twitch Credentials
TWITCH_TOKEN=oauth:your_twitch_access_token
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CHANNEL=your_twitch_channel_name
TWITCH_BOT_PREFIX=!
# Request Limits
# MAX_SONGS_PER_USER: Max songs per user (0 = unlimited)
MAX_SONGS_PER_USER=3
# USER_LIMIT_WINDOW_MINUTES: 0 = per stream/session, >0 = rolling window in minutes (e.g. 60)
USER_LIMIT_WINDOW_MINUTES=0
